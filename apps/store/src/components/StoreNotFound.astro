---
// src/components/StoreNotFound.astro
//
// Shown when the subdomain is not a syntactically valid DPNS username, or when
// resolution finds no store document for a valid one.
//
// The graphic is an inline SVG so it needs no external origin and the CSP in
// public/_headers (img-src 'self' https://placehold.co) stays unchanged.

interface Props {
    /** The subdomain label that was requested, echoed back for the user. */
    storeId?: string | null
    /** Why the store was not found, shown as a short line of helper text. */
    reason?: string
    /**
     * The homograph-normalized form of the requested name, when it differs
     * from the literal label. Shown so a user can see which name was actually
     * looked up — "Bob" and "B0b" are one name on Platform.
     */
    normalized?: string | null
}

const {
    storeId = null,
    reason = 'This address is not a valid Dash Platform store.',
    normalized = null,
} = Astro.props

/* Only show the normalized hint when it adds information. */
const showNormalized = normalized !== null && storeId !== null && normalized !== storeId
---

<div class="min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-gray-50 rounded-2xl shadow-xl overflow-hidden text-center">
        <div class="p-10">
            <svg
                class="w-32 h-32 mx-auto mb-6 text-gray-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M3 9l1.5-5h15L21 9" />
                <path d="M3 9h18v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9z" />
                <path d="M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0" />
                <line x1="5" y1="5" x2="19" y2="19" class="text-gray-500" />
            </svg>

            <h1 class="text-3xl font-bold text-gray-800 mb-3">Store Not Found</h1>

            <p class="text-gray-600 mb-2">{reason}</p>

            {storeId && (
                <p class="text-sm text-gray-500 break-all mb-2">
                    Requested store: <code class="bg-gray-200 rounded px-1 py-0.5">{storeId}</code>
                </p>
            )}

            {showNormalized && (
                <p class="text-sm text-gray-500 break-all mb-2">
                    Looked up as: <code class="bg-gray-200 rounded px-1 py-0.5">{normalized}</code>
                </p>
            )}

            <a
                href="https://paymedash.com"
                class="inline-block bg-blue-600 text-white font-bold py-3 px-8 rounded-lg hover:bg-blue-700 transition-colors mt-4"
            >
                Go to the home page
            </a>
        </div>
    </div>
</div>
