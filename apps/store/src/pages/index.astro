---
// apps/store/src/pages/index.astro
//
// The storefront, served from the root of every `*.paymedash.com` host that
// is not the apex. Cloudflare routes the host family here, so this one route is
// both the demo and every merchant's shop:
//
//   demo.paymedash.com     -> the built-in demo fixture (no network)
//   <USERNAME>.paymedash.com -> GET /v1/store -> the identity's proven `store`
//                                 document -> its active `storeItem` documents
//
// The page resolves the requested hostname and renders it. On a merchant host:
//
//   hostname label -> GET /v1/store -> the identity's proven `store` document
//                                  -> its active `storeItem` documents
//
// The endpoint lives in the `paymedash-api` Worker, which is routed in front of
// this site at paymedash.com/v1/*. It returns a store ONLY after the store
// document's grovedb proof has verified, and this page renders the store only
// when the response says so. A malformed host, an unregistered name, an
// identity with no store, or an unreachable API all render "Store Not Found"
// with a reason — the page never invents a storefront.
//
// Astro is a static build, so `Astro.request` carries the real request Host
// header only when this page is server-rendered. `prerender = false` is what
// makes that possible; without it the header is empty at build time and every
// host would render "Store Not Found". The hostname is read here, and the SAME
// functions are unit-tested in src/lib/store-host.test.ts.
//
// WHY THE FETCH HAPPENS ON THE SERVER
// The page is already server-rendered to read the Host header, so resolving the
// store in the same pass means the shop is in the first HTML response — no
// client-side loading state, no flash of an empty store, and no CORS concern
// (the request is same-origin from the Worker's point of view).

export const prerender = false

import Layout from '../layouts/Layout.astro'
import Storefront from '../components/Storefront.astro'
import StoreNotFound from '../components/StoreNotFound.astro'
import { products as demoProducts } from '../data/products'
import {
    isDemoHost,
    storeNameFromHostname,
    isValidStoreName,
    normalizeStoreName,
} from '../lib/store-host'
import {
    fetchStore,
    fetchStoreItems,
    toProduct,
    stringProperty,
} from '../lib/store-api'

/*
 * Reach the store resolver over a SERVICE BINDING rather than an HTTP fetch.
 *
 * WHY. This Worker is bound to the `*.paymedash.com/*` route, and a plain
 * `fetch('https://paymedash.com/v1/store')` from inside it does NOT reach the
 * `paymedash-api` Worker. It is resolved within the same zone, the wildcard
 * route re-enters this Worker, and `/v1/store` comes back as the landing page:
 * `200 text/html`. `store-api.ts` then fails `response.json()` and every
 * non-demo host renders "The store resolver returned a non-JSON response."
 * That is exactly what `store.paymedash.com`, `homemadecrypto.paymedash.com`
 * and every `<username>.paymedash.com` showed. The same code running on
 * `*.workers.dev` (no zone route) reaches the API correctly, which is what
 * isolates the cause to the edge re-route rather than to the client.
 *
 * A service binding is a direct Worker-to-Worker call: it names the script and
 * never consults routes, DNS or the zone, so the wildcard cannot shadow it.
 * The binding is declared as `API` in wrangler.jsonc.
 *
 * WHY `cloudflare:workers` AND NOT `Astro.locals.runtime.env`
 * The @astrojs/cloudflare adapter REMOVED `Astro.locals.runtime.env` in Astro
 * v6; the getter now throws (see its `createLocals` in cf-helpers.js). The
 * supported replacement is the `cloudflare:workers` module, which the adapter
 * marks external so workerd supplies it at runtime.
 *
 * THE IMPORT IS DYNAMIC AND GUARDED ON PURPOSE
 * `cloudflare:workers` only exists inside workerd. `astro dev` and the
 * `node --test` unit tests have no such module, so a static import would break
 * both. The import is therefore attempted at request time and any failure
 * falls back to the real global `fetch`, which is what dev and tests want.
 *
 * The fallback keeps `fetchStore`/`fetchStoreItems` unchanged: both already
 * accept an injected `fetchImpl`, so no signature changes are needed.
 */
type ResolverBinding = { fetch: typeof fetch }

async function resolveApiBinding(): Promise<ResolverBinding | undefined> {
    try {
        const mod = (await import(/* @vite-ignore */ 'cloudflare:workers')) as {
            env?: Record<string, unknown>
        }

        const binding = mod.env?.API

        return typeof binding === 'object' && binding !== null && 'fetch' in binding
            ? (binding as ResolverBinding)
            : undefined
    } catch {
        /* Not running in workerd (astro dev, node --test): no binding to use. */
        return undefined
    }
}

const resolverBinding = await resolveApiBinding()

/*
 * The `fetch` handed to `store-api.ts`. When the binding is present it rewrites
 * nothing about the URL: `paymedash-api` is the Worker that already answers
 * `/v1/store`, so the same absolute URL is passed through and the binding only
 * changes HOW the request is delivered. When the binding is absent the real
 * global `fetch` is used, unchanged.
 */
const resolverFetch: typeof fetch =
    resolverBinding === undefined
        ? fetch
        : (input: RequestInfo | URL, init?: RequestInit) => resolverBinding.fetch(input as RequestInfo, init)

const hostname = Astro.request.headers.get('host') ?? ''

/*
 * The `www` and `pos` hosts are proxied to their Pages origins in
 * `src/middleware.ts`, which runs for EVERY path -- that is where the forward
 * has to live, because a Pages site's `/_astro/...` bundles and
 * `/manifest.webmanifest` are separate requests that never reach this page.
 * By the time this page runs, the host is a storefront host.
 */

/*
 * The demo is a first-class host, not a special case bolted onto the resolver.
 * `demo.paymedash.com` is in RESERVED_SUBDOMAINS, so `storeNameFromHostname`
 * returns null for it and it can never be mistaken for a merchant named "demo".
 * Here it short-circuits before any network call and renders the local fixture.
 */
const isDemo = isDemoHost(hostname)

const candidate = isDemo ? null : storeNameFromHostname(hostname)
const isValid = candidate !== null && isValidStoreName(candidate)

/* The value a DPNS lookup compares against. Computed here so the reason text
 * can show the normalized form the network will actually use. */
const normalized = candidate === null ? null : normalizeStoreName(candidate)

/* Only a syntactically valid, non-demo host is worth a network call. */
const storeLookup = isValid && candidate !== null ? await fetchStore(candidate, resolverFetch) : null

/*
 * The products come from the resolver, not from a local fixture, once a store
 * is found. The listing is a SECOND proven read, keyed by the store document id
 * the first read returned, so a store's products are shown only after their own
 * proof verified. When the item read fails the page still renders the store,
 * with no products, because a product-list failure must not hide the store.
 *
 * The demo keeps the local fixture: it is the one host that is meant to render
 * with no store registered and no API reachable.
 */
let products = demoProducts
let itemsVerified = false

if (storeLookup !== null && storeLookup.status === 'found') {
    const items = await fetchStoreItems(storeLookup.store.documentId, resolverFetch)

    if (items.status === 'found') {
        products = items.items.map(toProduct).filter((product): product is NonNullable<typeof product> => product !== null)
        itemsVerified = true
    }
}

/*
 * Pick the sentence shown under "Store Not Found".
 *
 * A malformed host is answered without a network call, so it is distinguished
 * from the resolver's own reasons: the caller can tell a typo from a name that
 * is simply unregistered.
 */
function reasonFor(lookup: typeof storeLookup, candidate: string | null): string {
    if (candidate === null) return 'This address is not a store on Dash Platform.'

    if (!isValidStoreName(candidate)) {
        return `\u201c${candidate}\u201d is not a valid Dash Platform username (3 to 63 letters, digits or hyphens, no leading or trailing hyphen).`
    }

    if (lookup === null) return 'This address is not a store on Dash Platform.'

    return lookup.status === 'found' ? 'This address is not a store on Dash Platform.' : lookup.reason
}
---

{isDemo ? (
    <Layout title="Homemade Crypto — Demo" description="Interactive demo of the Homemade Crypto storefront.">
        <Storefront products={products} />
    </Layout>
) : storeLookup !== null && storeLookup.status === 'found' ? (
    <Layout
        title={`${stringProperty(storeLookup.store.properties, 'name') ?? candidate} — Stores on Dash Platform`}
        description={stringProperty(storeLookup.store.properties, 'description') ?? 'A storefront powered by Dash Platform.'}
    >
        <Storefront
            products={products}
            storeName={stringProperty(storeLookup.store.properties, 'name') ?? candidate}
            storeDescription={stringProperty(storeLookup.store.properties, 'description')}
            storeLogoUrl={stringProperty(storeLookup.store.properties, 'logoUrl') ?? stringProperty(storeLookup.store.properties, 'bannerUrl')}
            proofVerified={storeLookup.store.proofVerified}
            itemsVerified={itemsVerified}
        />
    </Layout>
) : (
    <Layout title="Store Not Found" description="No Dash Platform store exists at this address.">
        <StoreNotFound
            storeId={candidate}
            reason={reasonFor(storeLookup, candidate)}
            normalized={normalized}
        />
    </Layout>
)}
